<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Goals 🔥"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/txtDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="15sp"
            android:gravity="center"
            android:alpha="0.7"
            android:layout_marginTop="5dp" />

        <!-- STREAK CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:text="🔥"
                    android:textSize="42sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Days"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:id="@+id/txtStreakMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start your productivity streak!"
                    android:textSize="14sp"
                    android:alpha="0.7"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TODAY'S TASK GOAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Today's Task Goal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txtTaskGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 5 tasks completed"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/taskProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="5"
            android:progress="0"
            android:layout_marginTop="8dp" />

        <!-- STUDY GOAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Today's Study Goal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txtStudyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 3 hours"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/studyProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="180"
            android:progress="0"
            android:layout_marginTop="8dp" />

        <!-- DAILY GOAL CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="22dp">

                <TextView
                    android:id="@+id/txtGoalStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Keep going!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtGoalDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complete your daily goals to build a strong study habit."
                    android:textSize="14sp"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- CHECK-IN BUTTON -->

        <Button
            android:id="@+id/btnDailyCheckIn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🔥 Complete Daily Check-in"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>