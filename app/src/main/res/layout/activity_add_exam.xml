<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Exam 📝"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan your exams and prepare smarter."
            android:textSize="15sp"
            android:gravity="center"
            android:alpha="0.7"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="30dp" />

        <!-- SUBJECT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerExamSubject"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="5dp" />

        <!-- EXAM TITLE -->

        <EditText
            android:id="@+id/edtExamTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Exam Title"
            android:textSize="16sp"
            android:layout_marginTop="18dp" />

        <!-- DATE -->

        <Button
            android:id="@+id/btnExamDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📅 Select Exam Date"
            android:textAllCaps="false"
            android:layout_marginTop="18dp" />

        <!-- TIME -->

        <Button
            android:id="@+id/btnExamTime"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="⏰ Select Exam Time"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <!-- LOCATION -->

        <EditText
            android:id="@+id/edtExamLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Exam Room / Location"
            android:textSize="16sp"
            android:inputType="text"
            android:layout_marginTop="18dp" />

        <!-- SAVE -->

        <Button
            android:id="@+id/btnSaveExam"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="✓  Save Exam"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginTop="30dp" />

    </LinearLayout>

</ScrollView>