<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="25dp"
    android:paddingBottom="10dp">

    <!-- TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Study Schedule 📅"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Plan your week. Study with purpose. 🎯"
        android:textSize="14sp"
        android:gravity="center"
        android:alpha="0.7"
        android:layout_marginTop="5dp" />

    <!-- ADD BUTTON -->

    <Button
        android:id="@+id/btnAddSchedule"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="+  Add Study Session"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_marginTop="20dp" />

    <!-- DAY BUTTONS -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMonday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="MON"
                android:textAllCaps="false"
                android:minWidth="70dp" />

            <Button
                android:id="@+id/btnTuesday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="TUE"
                android:textAllCaps="false"
                android:minWidth="70dp" />

            <Button
                android:id="@+id/btnWednesday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="WED"
                android:textAllCaps="false"
                android:minWidth="70dp" />

            <Button
                android:id="@+id/btnThursday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="THU"
                android:textAllCaps="false"
                android:minWidth="70dp" />

            <Button
                android:id="@+id/btnFriday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="FRI"
                android:textAllCaps="false"
                android:minWidth="70dp" />

            <Button
                android:id="@+id/btnSaturday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SAT"
                android:textAllCaps="false"
                android:minWidth="70dp" />

            <Button
                android:id="@+id/btnSunday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SUN"
                android:textAllCaps="false"
                android:minWidth="70dp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- SELECTED DAY -->

    <TextView
        android:id="@+id/txtSelectedDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCHEDULE — MONDAY"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="8dp" />

    <!-- TODAY TOTAL -->

    <TextView
        android:id="@+id/txtTotalHours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 Study Time: 0h 0m"
        android:textSize="15sp"
        android:textStyle="bold"
        android:alpha="0.8"
        android:layout_marginBottom="8dp" />

    <!-- NEXT SESSION -->

    <TextView
        android:id="@+id/txtNextSession"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Next Study Session"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- EMPTY MESSAGE -->

    <TextView
        android:id="@+id/txtEmptySchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📚 No Study Sessions\n\nYou are free today! 🎉\nAdd a study session to plan your day."
        android:textSize="17sp"
        android:gravity="center"
        android:alpha="0.7"
        android:visibility="gone"
        android:padding="30dp" />

    <!-- RECYCLER VIEW -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scheduleRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

</LinearLayout>